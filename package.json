{
  "name": "chicken-olympics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "agent:bootstrap": "./scripts/agent-bootstrap.sh",
    "agent:verify": "./scripts/agent-verify.sh",
    "agent:teardown": "./scripts/agent-teardown.sh"
  },
  "dependencies": {
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.3",
    "eslint": "^9.39.2",
    "jiti": "^2.7.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "typescript-language-server": "^5.3.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
